# Install as /etc/joi-web.env with mode 0600. Never commit populated values.
#
# `_expand_env` reads these, and falls back to the system keyring when a name
# is unset -- which is how a developer machine works and a server does not.
# On a server every one of these has to be here.

# Hashes visitor IPs so the daily counter never stores an address. Generate
# once and keep it: regenerating resets everyone's daily count.
#   openssl rand -base64 48
JOI_WEB_IP_HASH_SECRET=

# Text model. Whatever you already pay for; this is the whole conversation.
JOI_LLM_BASE_URL=https://api.deepseek.com
JOI_LLM_MODEL=deepseek-v4-flash
JOI_LLM_API_KEY=

# Voice out. MiMo defaults its endpoint and model, so the key is the setup.
JOI_TTS_BASE_URL=
JOI_TTS_MODEL=
JOI_TTS_VOICE=
JOI_TTS_API_KEY=

# Voice in. One MiMo account covers both directions -- the same key works here.
JOI_ASR_BASE_URL=https://api.xiaomimimo.com/v1
JOI_ASR_MODEL=mimo-v2.5-asr
JOI_ASR_API_KEY=

# Realtime conversation. Billed by the minute, so the broker caps it: 180s per
# session and a daily ceiling, both set on the unit's command line.
JOI_QWEN_REALTIME_API_KEY=
