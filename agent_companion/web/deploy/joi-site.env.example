# Install as /etc/joi-site.env with mode 0600.
NODE_ENV=production
PORT=3000

# Same origin as the site, because Caddy serves both from one hostname.
NEXT_PUBLIC_JOI_BROKER_BASE=https://example.com

# The classic page's assistant. Leave empty to disable that chat; the page
# still renders.
DEEPSEEK_API_KEY=
JOI_WEB_MODEL=deepseek-v4-flash
